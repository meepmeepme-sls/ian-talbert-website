<%- include('partials/header') %>

<article class="post-container">
  <div style="margin-bottom: 1.5rem;">
    <a href="/blog" style="font-size: 0.88rem; font-variant-caps: all-small-caps; letter-spacing: 0.08em; color: var(--ink-tertiary); text-decoration: none;">
      &larr; Return to Field Notes Catalog
    </a>
  </div>

  <header class="treatise-header">
    <div class="treatise-num">
      <%= post.chapter || 'Technical Treatise' %> &middot; <%= post.date %> &middot; <%= post.readingTime %>
    </div>
    <h1 class="treatise-title" style="font-size: 2.1rem; margin-top: 0.25rem;">
      <%= post.title %>
    </h1>
    <% if (post.tags && post.tags.length) { %>
      <div class="treatise-meta" style="margin-top: 0.5rem;">
        Categories: <%= post.tags.join(' &middot; ') %>
      </div>
    <% } %>
  </header>

  <div class="post-content" style="margin-top: 2rem;">
    <%- post.html %>
  </div>

  <div style="border-top: 1px solid var(--rule-medium); margin-top: 3.5rem; padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/blog" class="btn-book btn-book-outline">&larr; All Dispatches</a>
    </div>
    <div>
      <a href="/portfolio" class="btn-book">Examine Engineering Portfolio &rarr;</a>
    </div>
  </div>
</article>

<%- include('partials/footer') %>
